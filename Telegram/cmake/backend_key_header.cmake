# This file is part of Whitegram for Desktop.
#
# Generates whitegram_backend_key.h: the backend API key XOR-obfuscated
# with a per-build random mask, so the plaintext is neither in git nor a
# plain string in the binary. The key itself lives only in the gitignored
# Telegram/build/whitegram_backend_key.txt (and in the server .env).
#
# Note: a determined reverse engineer can still XOR the two arrays from
# the binary; this hides the key from `strings` and from the repository,
# it is not a vault.
#
# cmake -Dkey_file=... -Doutput=... -P backend_key_header.cmake

if(EXISTS "${key_file}")
    file(READ "${key_file}" key_raw)
    string(STRIP "${key_raw}" key)
else()
    set(key "")
endif()

string(LENGTH "${key}" key_len)
set(content "#pragma once
// Generated by backend_key_header.cmake, do not edit.
namespace Whitegram::Backend::KeyDetail {
")

if(key_len GREATER 0)
    string(HEX "${key}" key_hex)
    math(EXPR mask_chars "${key_len} * 2")
    string(RANDOM LENGTH ${mask_chars} ALPHABET "0123456789abcdef" mask_hex)
    math(EXPR last "${key_len} - 1")
    set(blob_list "")
    set(mask_list "")
    foreach(i RANGE 0 ${last})
        math(EXPR off "${i} * 2")
        string(SUBSTRING "${key_hex}" ${off} 2 kh)
        string(SUBSTRING "${mask_hex}" ${off} 2 mh)
        math(EXPR xb "0x${kh} ^ 0x${mh}" OUTPUT_FORMAT HEXADECIMAL)
        string(APPEND blob_list "${xb},")
        string(APPEND mask_list "0x${mh},")
    endforeach()
    string(APPEND content "inline constexpr unsigned char kBlob[] = { ${blob_list} };
inline constexpr unsigned char kMask[] = { ${mask_list} };
inline constexpr int kLength = ${key_len};
")
else()
    string(APPEND content "inline constexpr unsigned char kBlob[] = { 0 };
inline constexpr unsigned char kMask[] = { 0 };
inline constexpr int kLength = 0;
")
endif()

string(APPEND content "} // namespace Whitegram::Backend::KeyDetail
")
file(WRITE "${output}" "${content}")
